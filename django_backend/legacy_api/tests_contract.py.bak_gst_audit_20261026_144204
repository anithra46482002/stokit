             patch("legacy_api.views_orders.transaction.atomic", side_effect=lambda: nullcontext()), \
             patch("legacy_api.views_orders.fetchone", return_value=self.user), \
             patch("legacy_api.views_orders.fetchall", return_value=[item]), \
             patch("legacy_api.views_orders.execute") as execute_mock, \
             patch("legacy_api.views_orders._insert_checkout_with_unique_id") as create_order:
