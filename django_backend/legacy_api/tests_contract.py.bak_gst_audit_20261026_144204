    def test_minimum_order_is_checked_before_credit_and_failed_request_keeps_cart(self):
        item = {
            "product_id": 1, "variant_id": 0, "qty": 1, "product_name": "Pen",
            "has_disc": 0, "discount_percent": 0, "discount_value": 0,
            "product_discount": 0, "variant_name": "", "price": Decimal("10.00"),
            "stock_qty": 1,
        }
