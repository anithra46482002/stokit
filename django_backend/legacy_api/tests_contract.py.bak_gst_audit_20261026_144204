class OrderIdAllocationTests(SimpleTestCase):
    def test_retries_a_real_checkout_primary_key_collision(self):
        duplicate = IntegrityError("duplicate checkout ID")
        postgres_error = Exception("duplicate key")
        postgres_error.diag = SimpleNamespace(constraint_name="zg_checkout_pkey")
        duplicate.__cause__ = postgres_error
        user = {"fullname": "Test User", "address": "Test Address", "phone": "0000000000", "email": "test@example.com"}
        with patch("legacy_api.views_orders.transaction.atomic", side_effect=lambda: nullcontext()), \
             patch("legacy_api.views_orders.execute") as execute_mock, \
             patch("legacy_api.views_orders.secrets.randbelow", side_effect=[0, 1]):
            execute_mock.side_effect = [duplicate, 1]
            result = _insert_checkout_with_unique_id(user, 123.0)
        self.assertEqual(result, 100001)
        self.assertEqual(execute_mock.call_count, 2)

class OrderPostValidationTests(SimpleTestCase):
    user = {
        "fullname": "Test User", "phone": "0000000000", "address": "Test Address",
        "email": "test@example.com", "delivery_charges": Decimal("0.00"),
        "vip_discount": "N", "vip_percentage": Decimal("0"),
    }

    def request(self):
        return RequestFactory().post("/api/order_post", HTTP_AUTHORIZATION="Bearer test")

    def auth_patches(self):
        return (
            patch("accounts.services.parse_bearer", return_value="test"),
            patch("accounts.services.authenticate_token", return_value=(None, {"username": "sample-user"})),
        )

    def test_missing_delivery_details_are_rejected_before_cart_changes(self):
        user = {**self.user, "address": ""}
        with self.auth_patches()[0], self.auth_patches()[1], \
             patch("legacy_api.views_orders.transaction.atomic", side_effect=lambda: nullcontext()), \
             patch("legacy_api.views_orders.fetchone", return_value=user), \
             patch("legacy_api.views_orders.execute") as execute_mock:
            response = order_post(self.request())
        self.assertEqual(response.status_code, 400)
        self.assertIn(b"delivery address and phone number", response.content)
        execute_mock.assert_not_called()

    def test_empty_cart_is_rejected_without_creating_an_order(self):
        with self.auth_patches()[0], self.auth_patches()[1], \
             patch("legacy_api.views_orders.transaction.atomic", side_effect=lambda: nullcontext()), \
             patch("legacy_api.views_orders.fetchone", return_value=self.user), \
             patch("legacy_api.views_orders.fetchall", return_value=[]), \
             patch("legacy_api.views_orders.execute") as execute_mock:
            response = order_post(self.request())
        self.assertEqual(response.status_code, 400)
        self.assertIn(b"Cart is empty", response.content)
