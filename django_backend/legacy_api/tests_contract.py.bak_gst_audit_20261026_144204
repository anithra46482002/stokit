        self.assertEqual(response.status_code, 400)
        self.assertIn(b"Add items worth", response.content)
        execute_mock.assert_not_called()
        create_order.assert_not_called()

    def test_order_at_minimum_is_accepted_using_pre_credit_total(self):
        item = {
            "product_id": 1, "variant_id": 0, "qty": 1, "product_name": "Pen",
            "has_disc": 0, "discount_percent": 0, "discount_value": 0,
            "product_discount": 0, "variant_name": "", "price": Decimal("91.74"),
            "stock_qty": 1,
        }
        with self.auth_patches()[0], self.auth_patches()[1], \
             patch("legacy_api.views_orders.transaction.atomic", side_effect=lambda: nullcontext()), \
             patch("legacy_api.views_orders.fetchone", return_value=self.user), \
             patch("legacy_api.views_orders.fetchall", return_value=[item]), \
             patch("legacy_api.views_orders.execute") as execute_mock, \
             patch("legacy_api.views_orders._insert_checkout_with_unique_id", return_value=123456) as create_order:
            response = order_post(self.request())
        self.assertEqual(response.status_code, 200)
        self.assertIn(b"\"status\": \"success\"", response.content)
        create_order.assert_called_once()
        self.assertGreaterEqual(execute_mock.call_count, 2)

    def test_repeated_order_post_does_not_create_a_second_order_for_cleared_cart(self):
        item = {
            "product_id": 1, "variant_id": 0, "qty": 1, "product_name": "Pen",
            "has_disc": 0, "discount_percent": 0, "discount_value": 0,
            "product_discount": 0, "variant_name": "", "price": Decimal("150.00"),
            "stock_qty": 1,
        }
        with self.auth_patches()[0], self.auth_patches()[1], \
             patch("legacy_api.views_orders.transaction.atomic", side_effect=lambda: nullcontext()), \
             patch("legacy_api.views_orders.fetchone", return_value=self.user), \
             patch("legacy_api.views_orders.fetchall", side_effect=[[item], []]), \
             patch("legacy_api.views_orders.execute") as execute_mock, \
             patch("legacy_api.views_orders._insert_checkout_with_unique_id", return_value=123456) as create_order:
            first = order_post(self.request())
            second = order_post(self.request())
        self.assertEqual(first.status_code, 200)
        self.assertEqual(second.status_code, 400)
        self.assertIn(b"Cart is empty", second.content)
        create_order.assert_called_once()
        self.assertEqual(execute_mock.call_count, 2)

    def test_variant_with_insufficient_stock_is_rejected(self):
        item = {
            "product_id": 1, "variant_id": 2, "qty": 2, "product_name": "Pen",
            "has_disc": 0, "discount_percent": 0, "discount_value": 0,
            "product_discount": 0, "variant_name": "Blue", "price": Decimal("10.00"),
            "stock_qty": 1,
        }
        with self.auth_patches()[0], self.auth_patches()[1], \
             patch("legacy_api.views_orders.transaction.atomic", side_effect=lambda: nullcontext()), \
             patch("legacy_api.views_orders.fetchone", return_value=self.user), \
             patch("legacy_api.views_orders.fetchall", return_value=[item]), \
             patch("legacy_api.views_orders.execute") as execute_mock:
            response = order_post(self.request())
        self.assertEqual(response.status_code, 409)
        self.assertIn(b"Only 1 unit(s)", response.content)
        execute_mock.assert_not_called()


class CreditReleaseReportTests(SimpleTestCase):
    """current_available_credit must reflect the customer's real allocation and this month's usage only."""

    @staticmethod
    def _context(state):
        return {"state": state, "terms": None, "applied": {}, "today": date(2026, 10, 15)}

    @staticmethod
    def _state(used, payment="36000", bonus="10", months=12):
        terms = mc.AllocationTerms(1, 7, Decimal(payment), Decimal(bonus), months, date(2026, 10, 1), date(2027, 9, 30), "ACTIVE")
        return mc.evaluate(terms, Decimal(used), Decimal(used), date(2026, 10, 15))

    def test_customer_without_allocation_gets_zero_credit(self):
        context = self._context(mc.no_allocation_state(date(2026, 10, 15)))
        with patch("legacy_api.views_finance.current_credit_context", return_value=context):
            self.assertEqual(current_available_credit({"email": "test@example.com"}), (0.0, 0.0, 0.0))

    def test_available_credit_is_monthly_release_minus_current_month_usage(self):
        context = self._context(self._state("2500.00"))
        with patch("legacy_api.views_finance.current_credit_context", return_value=context):
            monthly, carried, available = current_available_credit({"email": "test@example.com"})
        self.assertEqual((monthly, carried, available), (3600.0, 0.0, 1100.0))

    def test_unused_credit_never_carries_into_available_credit(self):
        context = self._context(self._state("0.00"))
        with patch("legacy_api.views_finance.current_credit_context", return_value=context):
            monthly, carried, available = current_available_credit({"email": "test@example.com"})
        self.assertEqual((monthly, carried, available), (3600.0, 0.0, 3600.0))

class CartCalculationContractTests(SimpleTestCase):
    def test_empty_cart_keeps_legacy_nested_response_keys(self):
        result = _build_cart_response('sample-user', [], [], 0)
        self.assertEqual(result['status'], 'success')
        self.assertIn('discount_available', result['cart_items'])
        self.assertIn('discount_not_available', result['cart_items'])
        summary = result['cart_items']['final_summary']
        for key in ('items_subtotal', 'GST', 'credit_release', 'credit_applied', 'carry_forward_to_next_month', 'payable_amount', 'total_billed_amount', 'vip_discount', 'delivery', 'order_total_before_credit', 'MOK-diff', 'carried_forward_from_previous_month', 'available_credit', 'final_total_price', 'total_cart_items'):
            self.assertIn(key, summary)
        self.assertEqual(summary['final_total_price'], 0.0)
        self.assertEqual(summary['payable_amount'], 0.0)
        self.assertEqual(summary['total_billed_amount'], 0.0)
        self.assertEqual(summary['carry_forward_to_next_month'], 0.0)

    def test_credit_math_exceeds_exact_partial_and_zero_credit_cases(self):
        self.assertEqual(_calculate_credit_totals(2565.86, 3000.0), (2565.86, 0.0, 0.0))
        self.assertEqual(_calculate_credit_totals(2565.86, 2565.86), (2565.86, 0.0, 0.0))
        self.assertEqual(_calculate_credit_totals(2565.86, 2000.0), (2000.0, 565.86, 0.0))
        self.assertEqual(_calculate_credit_totals(2565.86, 0.0), (0.0, 2565.86, 0.0))

    def test_credit_exceeds_order_total_and_unused_credit_expires(self):
        item = {'sub_total': 2354.0, 'discounted_subtotal': 2354.0, 'discount_amount': 0.0,
                'discount_percent': 0.0, 'quantity': 1}
        summary = _build_cart_response('sample-user', [], [item], 0, credit_release=3000.0)['cart_items']['final_summary']
        self.assertEqual(summary['GST'], 0.0)
        self.assertEqual(summary['payable_amount'], 0.0)
        self.assertEqual(summary['total_billed_amount'], 0.0)
        self.assertEqual(summary['final_total_price'], 0.0)
        self.assertEqual(summary['credit_applied'], 2354.0)
        self.assertEqual(summary['carry_forward_to_next_month'], 0.0)
        self.assertEqual(summary['order_total_before_credit'], 2354.0)
        self.assertEqual(summary['MOK-diff'], 0.0)
    def test_cart_spends_only_the_remaining_credit_of_the_current_month(self):
        item = {'sub_total': 2708.0, 'discounted_subtotal': 2708.0, 'discount_amount': 0.0,
                'discount_percent': 0.0, 'quantity': 1}
        summary = _build_cart_response(
            'sample-user', [], [item], 0, credit_release=3600.0, available_credit=1100.0,
        )['cart_items']['final_summary']
        self.assertEqual(summary['credit_release'], 3600.0)
        self.assertEqual(summary['carried_forward_from_previous_month'], 0.0)
        self.assertEqual(summary['available_credit'], 1100.0)
        self.assertEqual(summary['credit_applied'], 1100.0)
        self.assertEqual(summary['payable_amount'], 1608.0)
        self.assertEqual(summary['carry_forward_to_next_month'], 0.0)

    def test_cart_without_credit_arguments_applies_no_credit(self):
        item = {'sub_total': 2354.0, 'discounted_subtotal': 2354.0, 'discount_amount': 0.0,
                'discount_percent': 0.0, 'quantity': 1}
        summary = _build_cart_response('sample-user', [], [item], 0)['cart_items']['final_summary']
        self.assertEqual(summary['credit_release'], 0.0)
        self.assertEqual(summary['available_credit'], 0.0)
        self.assertEqual(summary['credit_applied'], 0.0)
        self.assertEqual(summary['payable_amount'], 2354.0)

    def test_credit_exactly_covers_order_total(self):
        item = {'sub_total': 2354.0, 'discounted_subtotal': 2354.0, 'discount_amount': 0.0,
                'discount_percent': 0.0, 'quantity': 1}
        summary = _build_cart_response('sample-user', [], [item], 0, credit_release=2565.86)['cart_items']['final_summary']
        self.assertEqual(summary['GST'], 0.0)
        self.assertEqual(summary['payable_amount'], 0.0)
        self.assertEqual(summary['carry_forward_to_next_month'], 0.0)

    def test_partial_credit_leaves_positive_payable(self):
        self.assertEqual(_calculate_credit_totals(2565.86, 2000.0), (2000.0, 565.86, 0.0))

    def test_payable_and_carry_forward_never_become_negative(self):
        item = {'sub_total': 5000.0, 'discounted_subtotal': 5000.0, 'discount_amount': 0.0,
                'discount_percent': 0.0, 'quantity': 1}
        summary = _build_cart_response('sample-user', [], [item], 0, credit_release=3000.0)['cart_items']['final_summary']
        self.assertGreaterEqual(summary['payable_amount'], 0.0)
        self.assertGreaterEqual(summary['carry_forward_to_next_month'], 0.0)
        self.assertEqual(summary['payable_amount'], 2000.0)
        self.assertEqual(summary['carry_forward_to_next_month'], 0.0)
    def test_minimum_order_discount_applies_to_undiscounted_group(self):
        item = {'sub_total': 15000.0, 'discounted_subtotal': 15000.0, 'discount_amount': 0.0,
                'discount_percent': 0.0, 'quantity': 1}
        result = _build_cart_response('sample-user', [], [item], 0)
        cart = result['cart_items']
        group = cart['discount_not_available']['2']
        self.assertTrue(cart['mov']['cart_discount_applied'])
        self.assertEqual(group['items'][0]['discounted_subtotal'], 13500.0)
        self.assertEqual(group['items'][0]['discount_percent'], 10.0)
        self.assertEqual(cart['final_summary']['cart_discount_amount'], 1500.0)

    def test_below_minimum_order_value_does_not_apply_cart_discount(self):
        item = {'sub_total': 100.0, 'discounted_subtotal': 100.0, 'discount_amount': 0.0,
                'discount_percent': 0.0, 'quantity': 2}
        result = _build_cart_response('sample-user', [], [item], 25)
        cart = result['cart_items']
        self.assertFalse(cart['mov']['cart_discount_applied'])
        self.assertEqual(cart['discount_not_available']['2']['items'][0]['discounted_subtotal'], 100.0)
        self.assertEqual(cart['final_summary']['delivery'], 25.0)



    def test_mixed_cart_applies_cart_discount_only_to_discount_free_lines(self):
        discounted_line = {
            "sub_total": 20000.0, "discounted_subtotal": 16000.0,
            "discount_amount": 4000.0, "discount_percent": 20.0, "quantity": 1,
        }
        eligible_line = {
            "sub_total": 15000.0, "discounted_subtotal": 15000.0,
            "discount_amount": 0.0, "discount_percent": 0.0, "quantity": 1,
        }
        result = _build_cart_response("sample-user", [discounted_line], [eligible_line], 0)
        cart = result["cart_items"]
        self.assertTrue(cart["mov"]["cart_discount_applied"])
        self.assertEqual(cart["discount_available"]["1"]["items"][0]["discounted_subtotal"], 16000.0)
        self.assertEqual(cart["discount_available"]["1"]["items"][0]["discount_percent"], 20.0)
        self.assertEqual(cart["discount_not_available"]["2"]["items"][0]["discounted_subtotal"], 13500.0)
        self.assertEqual(cart["final_summary"]["cart_discount_amount"], 1500.0)

    def test_vip_discount_prevents_cart_discount_stacking(self):
        eligible_line = {
            "sub_total": 15000.0, "discounted_subtotal": 15000.0,
            "discount_amount": 0.0, "discount_percent": 0.0, "quantity": 1,
        }
        result = _build_cart_response(
            "vip-user", [], [eligible_line], 0, vip_applied=True, vip_percentage=20,
        )
        cart = result["cart_items"]
        self.assertFalse(cart["mov"]["cart_discount_applied"])
        self.assertEqual(cart["mov"]["cart_discount_percent"], 0.0)
        self.assertEqual(cart["final_summary"]["cart_discount_amount"], 0.0)
        self.assertEqual(cart["discount_not_available"]["2"]["items"][0]["discounted_subtotal"], 15000.0)
        self.assertEqual(cart["final_summary"]["vip_discount"], 3000.0)

