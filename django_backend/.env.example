# Copy to .env and fill in. NEVER commit .env. No value here is a real secret.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Database (MySQL 8.x or MariaDB 11.x). A separate DEVELOPMENT schema, never production.
DB_NAME=stokit_dev
DB_USER=stokit_dev
DB_PASSWORD=Apple@123
DB_HOST=127.0.0.1
DB_PORT=3306

# Legacy media (files uploaded by the old PHP admin live under <MEDIA_ROOT>/uploads/...)
MEDIA_ROOT=
LEGACY_BASE_URL=https://app.stokitb2b.com/admin/manage/

# Session policy (see accounts/README section in docs)
MAX_ACTIVE_SESSIONS=unlimited
SESSION_INACTIVITY_DAYS=30
SESSION_TOUCH_INTERVAL_SECONDS=300

# React admin (ADMIN_FRONTEND_URL: where /admin and /admin/ redirect; leave empty to disable)
ADMIN_FRONTEND_URL=http://127.0.0.1:5173/
ADMIN_TOKEN_MAX_AGE_SECONDS=28800
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password-reset e-mail (default prints to console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost
# Serve MEDIA_ROOT/uploads at /admin/manage/uploads/ and allow admin image uploads (local/ngrok dev). Leave 0 in production if media lives elsewhere.
SERVE_LOCAL_UPLOADS=0
# Set 1 only behind a trusted proxy (ngrok, nginx) so request-built image URLs use https.
TRUST_X_FORWARDED_PROTO=0
