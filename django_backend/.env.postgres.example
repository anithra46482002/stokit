# Optional PostgreSQL development configuration template only.
# Copy to .env.postgres locally; never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DB_ENGINE=django.db.backends.postgresql
DB_NAME=stokit_postgres_dev
DB_USER=postgres
DB_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
# Serve MEDIA_ROOT/uploads at /admin/manage/uploads/ and allow admin image uploads (local/ngrok dev).
SERVE_LOCAL_UPLOADS=0
# Set 1 only behind a trusted proxy (ngrok/nginx) so request-built image URLs use https.
TRUST_X_FORWARDED_PROTO=0
# Minimum order total before customer credit is applied (legacy default: ₹100).
STOKIT_MIN_ORDER_VALUE=100.00
# Monthly credit release used by the finance calculation (legacy default: ₹3000).
